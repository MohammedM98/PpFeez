{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PpFeez",
  "version": "0.6.2",
  "identifier": "com.ppfeez.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PpFeez",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; frame-src 'self' about: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "PpFeez",
    "shortDescription": "محاسبة دفعات PayPal للعملاء",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Arabic",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MohammedM98/PpFeez/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3ODZDMDgyN0Q3QjlFNUUKUldSZW5udDlnc0NHZC9KWDdzUm04VlZKM1FHOGJxR3hIQzkvRXh4QzMzc3FObXpWdmMzdDVZNEoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
